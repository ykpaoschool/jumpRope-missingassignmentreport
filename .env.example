# Azure AD 应用凭据（client credentials）
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# 共享邮箱地址（UPN，用于发信）
SHARED_MAILBOX=

# 发件人显示名（可选）
SENDER_DISPLAY_NAME=教务部门 Academic Office

# —— SMTP 渠道（快速测试用，无需 Azure）——
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 587 端口通常需 STARTTLS；465 端口自动走 SSL
SMTP_STARTTLS=true

# 每封邮件发送间隔（秒），规避限流
SEND_DELAY_SECONDS=0.5
